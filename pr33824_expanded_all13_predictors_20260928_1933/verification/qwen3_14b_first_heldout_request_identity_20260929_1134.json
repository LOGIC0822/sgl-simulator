84_inf\",64)):\n    folder=group/\"cases\"/case\n    assert read(folder/\"status.txt\").strip()==\"ok\"\n    server=shlex.split(read(folder.parent/(case+\".server.command.txt\")))\n    client=shlex.split(read(folder.parent/(case+\".benchmark.command.txt\")))\n    def arg(argv,key):\n        assert argv.count(key)==1,(case,key)\n        return argv[argv.index(key)+1]\n    assert arg(client,\"--seed\")==\"202609380\" and int(arg(client,\"--num-prompts\"))==n\n    assert arg(server,\"--device\")==\"cuda\" and arg(server,\"--attention-backend\")==\"triton\"\n    assert arg(server,\"--mem-fraction-static\")==\"0.60\" and arg(server,\"--context-length\")==\"2048\"\n    assert \"--disable-cuda-graph\" in server and \"--disable-overlap-schedule\" in server\n    manifest=json.loads(read(folder/\"TP0.manifest.json\"))\n    benchmark=records(folder/\"benchmark.jsonl\")[-1]\n    raw=records(folder/\"TP0.raw_request.jsonl\")\n    trace=records(folder/\"autobench_trace.jsonl\")\n    assert len(raw)==len(trace)==manifest[\"request_count\"]==benchmark[\"completed\"]==n\n    assert benchmark[\"server_info\"][\"device\"]==\"cuda\" and benchmark[\"server_info\"][\"attention_backend\"]==\"triton\"\n    ids={r[\"rid\"] for r in raw}; assert len(ids)==n and not test_ids & ids\n    test_ids.update(ids); test_prompts.update(prompt_hash(r) for r in raw)\n    copied={r[\"metadata\"][\"source_rid\"]:r for r in trace}\n    assert set(copied)==ids\n    for row in raw:\n        replay=copied[row[\"rid\"]]\n        assert row[\"input_ids\"]==replay[\"prompt\"] and len(row[\"input_ids\"])==row[\"input_length\"]==replay[\"prompt_len\"]\n        assert len(row[\"output_ids\"])==row[\"output_length\"]==replay[\"output_len\"]\n    batches=records(folder/\"TP0.schedule_batch.jsonl\")\n    assert len(batches)==manifest[\"schedule_batch_count\"]\n    assert manifest[\"batch_timing\"]==\"device_synchronized\" and manifest[\"batch_latency_unit\"]==\"seconds\"\n    phase={1:0,2:0}\n    for row in batches:\n        latency=float(row[\"iter_latency\"])\n        assert row[\"forward_mode\"] in phase and row[\"request_infos\"] and math.isfinite(latency) and latency>0\n        assert math.isclose(row[\"end_timestamp\"]-row[\"start_timestamp\"],latency,rel_tol=1e-12,abs_tol=1e-12)\n        assert {r[\"rid\"] for r in row[\"request_infos\"]}<=ids\n        phase[row[\"forward_mode\"]]+=1\n    counts.append({\"case\":case,\"requests\":n,\"timing_rows\":len(batches),\"prefill_rows\":phase[1],\"decode_rows\":phase[2]})\nassert len(test_ids)==256 and not train_ids & test_ids and not train_prompts & test_prompts\nfor path,digest in hashes.items(): assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest\nresult={\"at\":datetime.now().astimezone().isoformat(),\"model\":\"Qwen3-14B\",\"closed_heldout_groups\":1,\"training_requests\":len(train_ids),\"unique_training_prompts\":len(train_prompts),\"test_requests\":len(test_ids),\"unique_test_prompts\":len(test_prompts),\"cross_role_request_id_overlap\":len(train_ids & test_ids),\"cross_role_complete_prompt_overlap\":len(train_prompts & test_prompts),\"test_timing_rows\":sum(r[\"timing_rows\"] for r in counts),\"test_prefill_rows\":sum(r[\"prefill_rows\"] for r in counts),\"test_decode_rows\":sum(r[\"decode_rows\"] for r in counts),\"case_counts\":counts,\"heldout_package_versions_equal_training\":True,\"source_sha256_unchanged\":hashes,\"fit_prediction_or_gpu_work\":False,\"scope\":\"Completed first heldout group versus all completed training requests; identity and native observation integrity only, not accuracy or all-five heldout completion.\"}\nprint(json.dumps(result))\n",
