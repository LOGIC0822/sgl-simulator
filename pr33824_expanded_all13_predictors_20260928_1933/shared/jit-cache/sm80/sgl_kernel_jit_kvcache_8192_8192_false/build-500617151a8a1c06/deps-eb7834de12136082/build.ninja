ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.2/bin/nvcc
cxxflags = -fPIC -std=c++20 -O3 -I/home/ms-admin/workspace1/.miniforge3/envs/hbf-cxl/lib/python3.10/site-packages/tvm_ffi/include -I/home/ms-admin/workspace1/yiheng/ali/sglang-pr33824-merged/python/sglang/kernels/jit/include
cudaflags = -Xcompiler -fPIC -gencode=arch=compute_80,code=sm_80 -DSGL_CUDA_ARCH=800 -std=c++20 -O3 --expt-relaxed-constexpr -I/home/ms-admin/workspace1/.miniforge3/envs/hbf-cxl/lib/python3.10/site-packages/tvm_ffi/include -I/home/ms-admin/workspace1/yiheng/ali/sglang-pr33824-merged/python/sglang/kernels/jit/include
ldflags = -shared -L/home/ms-admin/workspace1/.miniforge3/envs/hbf-cxl/lib/python3.10/site-packages/tvm_ffi/lib -ltvm_ffi -L/usr/local/cuda-12.2/lib64 -lcudart

rule compile_cxx
  depfile = $out.d
  command = $cxx -MD -MF "$out.d" $cxxflags -c "$in" -o "$out"

rule compile_cuda
  depfile = $out.d
  command = $nvcc -MD -MF "$out.d" $cudaflags -c "$in" -o "$out"

rule link
  command = $cxx $in $ldflags -o "$out"

build cuda_0.o: compile_cuda cuda.cu

build sgl_kernel_jit_kvcache_8192_8192_false.so: link cuda_0.o

default sgl_kernel_jit_kvcache_8192_8192_false.so
