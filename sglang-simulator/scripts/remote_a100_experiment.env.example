# Copy to remote_a100_experiment.env and edit. Do not put passwords or private keys here.

REMOTE_HOST="user@a100-host"
REMOTE_PORT="22"
REMOTE_ROOT="/data/user/sglang-experiment-runs"
REMOTE_PYTHON="/opt/conda/envs/sglang-a100/bin/python"
REMOTE_MODEL_ROOT="/data/models"
REMOTE_GPU_ID="0"

# Local CPU environment and local model configuration/checkpoints.
LOCAL_PYTHON="/path/to/local-cpu-env/bin/python"
LOCAL_MODEL_ROOT="/mnt/data/models"

# Source checkouts/artifacts available in this workspace.
AICONFIGURATOR_SOURCE_ROOT="/home/ms-admin/workspace1/yiheng/ali/aiconfigurator-v0.10.0"
KERNEL_COMPAT_STAGE="/home/ms-admin/workspace1/yiheng/ali/sglang-pr33824-merged/tools/sglang-simulator/test-results/pr33824_sglang_kernel_sm80_compat_20260908_1915/minimal-stage-v4"

# Blank RUN_ID creates a timestamped isolated run. Reuse the printed ID with --resume.
RUN_ID=""
LOCAL_RESULTS_ROOT=""
MODELS="Qwen3-0.6B,Qwen2.5-3B-Instruct,llama-2-7b,Mistral-7B-Instruct-v0.2,Qwen2.5-7B-Instruct,Qwen3-8B,Qwen2.5-14B-Instruct,Qwen2.5-14B-Instruct-1M,Qwen3-14B,Meta-Llama-3.1-70B-Instruct-AWQ,Qwen3-30B-A3B,Qwen3-30B-A3B-Instruct-2507,Qwen3-32B"
TRAIN_REPEATS="5"
HOLDOUT_REPEATS="5"
PROMPT_MULTIPLIER="2"
TRAIN_CASES="latency_256x128_r1,service_1024x256_r4,saturation_1024x256_inf"
HOLDOUT_CASES="latency_256x128_r1,service_1024x256_r4,saturation_1024x256_inf,latency_128x64_r1,saturation_1536x384_inf"
